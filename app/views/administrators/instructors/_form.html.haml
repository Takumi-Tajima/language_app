= simple_form_for [:administrators, instructor] do |f|
  = render 'layouts/shared/error_messages', resource: instructor
  .row
    .col-6= f.input :name
    .col-6= f.input :email
  .row
    .col-6= f.input :password
    .col-6= f.input :password_confirmation
  = f.button :submit, class: 'btn-primary'
